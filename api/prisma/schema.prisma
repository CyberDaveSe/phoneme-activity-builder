generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ActivityType {
  WORDLE
  WORD_SEARCH
}

model Word {
  id         Int           @id @default(autoincrement())
  text       String
  hint       String?
  difficulty Difficulty
  phonemes   WordPhoneme[]
  activities ActivityWord[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model WordPhoneme {
  id       Int    @id @default(autoincrement())
  symbol   String
  position Int

  wordId Int
  word   Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([wordId, position])
}

model Activity {
  id           Int          @id @default(autoincrement())
  name         String
  type         ActivityType
  difficulty   Difficulty
  hintsEnabled Boolean      @default(false)
  board        Json?
  words        ActivityWord[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ActivityWord {
  activityId Int
  wordId     Int

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  word     Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([activityId, wordId])
}